# Copia este archivo como .env (NO se sube a git)
SECRET_KEY=cambia-esto-por-una-clave-larga
# Local: vacío = SQLite. Para usar Postgres local:
# DATABASE_URL=postgres://usuario:clave@localhost:5432/ordo
DATABASE_URL=

# Cloudinary (vacío = archivos en carpeta media/ local)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

